# LUDIA NAIL · Vercel environment example
# Never commit real values.

# Browser Salon OS (safe public client key; RLS must be enabled)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Naver bridge persistence.
# Prefer the modern secret key. Keep this value only in Vercel/server environments.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Local Windows Naver bridge -> Vercel API
LUDIA_SYNC_TOKEN=replace_with_long_random_token

# Optional: protect /api/naver-status if it is not meant to be public.
LUDIA_DASHBOARD_TOKEN=replace_with_optional_dashboard_token

# Optional legacy compatibility only. Do not use in browser code.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
